# =============================================================================
# hosted-web template — environment variables (COMMITTED, placeholders only)
# =============================================================================
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# The app builds and runs with EVERY value below unset — nothing here is read
# at import/build time, only lazily inside request handlers (see lib/env.ts).
# =============================================================================

# --- Database (Supabase Postgres — one project per client) -------------------
# Direct connection string for migrations and server-side queries.
# Absent = no DB-backed features; /health reports db "unconfigured".
DATABASE_URL="postgres://postgres:password@db.your-project.supabase.co:5432/postgres"

# --- Supabase (auth, storage, REST) ------------------------------------------
# URL and anon key are browser-safe (NEXT_PUBLIC_, RLS applies). The
# service-role key BYPASSES RLS: server-only, never in client-side code.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# --- AI (per-app, bring-your-own-key) ----------------------------------------
# The AI module is OPT-IN. It stays dormant unless AI_ENABLED is truthy AND a
# key is present. With AI_ENABLED unset, ANTHROPIC_API_KEY is never read.
AI_ENABLED="0"
ANTHROPIC_API_KEY="sk-ant-your-api-key"

# --- Agent runner (skill buttons, chat, scheduled jobs) ----------------------
# Every agent run spawns `claude -p` as a SPECIFIC employee, using a token that
# person issued with `claude setup-token` on their own machine. Those tokens are
# stored in the `agent_tokens` table, sealed with AES-256-GCM under this key.
#
# Generate one with:  openssl rand -base64 32
# It must decode to exactly 32 bytes. Lose it and every enrolled employee has to
# reconnect their seat from /account — which is a nuisance, not a breach, since
# the sealed rows are inert without it. Rotating it has the same effect, so
# rotate deliberately.
AGENT_TOKEN_KEY="base64_32_random_bytes"

# Where the bcns-os clone lives on this host. The agent's working directory, so
# it is also what decides which skills and which knowledge a run can reach.
# Read at call time, so repointing it needs no restart. Default: ~/os
OS_DIR="/home/bcns/os"

# The claude CLI to spawn. A service's PATH is not an interactive shell's, so
# set this to an absolute path on the droplet rather than trusting PATH.
CLAUDE_BIN="claude"

# Model slug for agent runs, tunable without a redeploy. Default: sonnet
CHAT_MODEL="sonnet"

# How many agent runs may be in flight at once, across everyone. A blast-radius
# cap, not load control — a retry loop must not fan out. Default: 2
AGENT_MAX_CONCURRENT="2"

# --- Notification email: the bot mailbox on Google Workspace -----------------
# All five must be set or sending stays off and mail parks in `email_outbox`
# as `pending`. SMTP_PASS is a Google APP PASSWORD, never the account password.
# Setup steps: docs/NOTIFICATIONS.md. Real values go in .env.local, never here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=bot@bcn-services.com
SMTP_PASS=
MAIL_FROM=bcns <bot@bcn-services.com>

# Comma-separated. Anything not listed is rendered and recorded but never sent,
# so a half-finished setup cannot mail a real customer.
NOTIFY_ALLOWED_RECIPIENTS=nseluga@g.hmc.edu
